<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launcher_background">#0B0F14</color>
    <color name="window_background">#F2F6F7</color>
    <bool name="light_system_bars">true</bool>

    <style name="Theme.Altimeter" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/launcher_background</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
